# Copy to backend/.env (git-ignored) and fill in.
#
# One file for both ways of running the API:
#   npm run dev / npm start   Node reads it via --env-file-if-exists
#   Docker                    compose.yaml passes it to the container
#
# Two rules, because Docker reads it as well as Node:
#   * No `$` anywhere in a value. Compose treats $NAME inside a value as a
#     variable to substitute, so `abc$xyz` reaches the container as `abc` —
#     a different secret from the one Node sees. Generate secrets with
#     `openssl rand -hex 32`, which never produces one.
#   * Inside a container, 127.0.0.1 is the container itself, not your machine.
#     A local MongoDB is unreachable from Docker; use an Atlas URI there.

# Required. The server connects before it opens its port and exits if it
# cannot. Accounts, saved stops/lines/journeys and travel cards live here.
# Local:  mongodb://127.0.0.1:27017/journey_planner_db
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/journey_planner_db?retryWrites=true
MONGO_URI=mongodb://127.0.0.1:27017/journey_planner_db

# Required. Signs the session cookie; every login fails without it. Changing
# it signs everyone out.
JWT_SECRET_KEY=

# Optional. How long a session lasts. Default 30d.
JWT_EXPIRES_IN=30d

# Optional. Default 3000. Leave it at 3000 under Docker: the frontend
# container's Caddyfile forwards /api to port 3000.
PORT=3000

# How much the server logs: debug, info (the default), warn or error.
# `debug` adds how long each calculation took; `warn` keeps only problems.
# Output is JSON lines when NODE_ENV=production (the Docker image sets it),
# readable coloured lines otherwise.
# LOG_LEVEL=info

# Optional with npm, ignored under Docker. Unset, the server takes the network
# from pipelineConfig.js, which is what compiled the data on disk — leave it
# unset unless you mean to override that. Under Docker it comes from the root
# .env instead, and that value wins.
# ACTIVE_NETWORK=hsl
