# Copy to backend/.env and edit. That file is git-ignored; this one is not.
#
# Read natively by Node through `--env-file-if-exists` in the npm scripts, so
# there is no dotenv dependency. In production the value comes from the real
# environment instead and no file needs to exist.

# The card store. Only the /api/card endpoints use it — everything else is
# served from the compiled feed in memory and runs without it.
MONGO_URI=mongodb://127.0.0.1:27017/journey_planner_db
