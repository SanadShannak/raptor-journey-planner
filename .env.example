# Copy to .env (git-ignored) beside compose.yaml. Read by Docker Compose itself
# and by nothing else — npm never sees this file.
#
# Only needed for the containers. Running the project with npm, the backend
# takes its network from offline-data-ingestion-pipeline/pipelineConfig.js.

# Which compiled network to serve. Compose uses it twice: to find the data
# folder to mount (./processed-data/<network>-processed-data) and to tell the
# backend container which network it is. One value, so the two cannot disagree.
# Compose refuses to start if it is missing.
ACTIVE_NETWORK=hsl
