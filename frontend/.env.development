# Development defaults, committed so `npm run dev` works without setup.
# Override locally in .env.local (git-ignored).

# Same origin: the dev server proxies /api to the backend (see vite.config.ts).
# This is not a shortcut — the session is an HTTP-only cookie, and the API's
# `Access-Control-Allow-Origin: *` cannot be combined with credentials, so a
# cross-origin base fails every call under /api/auth, /api/user and /api/cards.
VITE_API_BASE_URL=/

# Where that proxy forwards to. Matches backend/src/serverConfig.js.
VITE_DEV_API_PROXY=http://localhost:3000

VITE_DIGITRANSIT_SUBSCRIPTION_KEY=2824640944e74c849b739e5c807c2679
