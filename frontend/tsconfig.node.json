{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /*
   * Everything here runs in Node rather than the browser: the Vite config, and
   * the test that walks the repo's own files to check the paths quoted in the
   * docs. tsconfig.app.json excludes that test for the same reason.
   */
  "include": ["vite.config.ts", "src/test/docPaths.test.ts"]
}
