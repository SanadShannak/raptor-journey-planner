# Committed, non-secret settings. Vite reads this file in every mode — the dev
# server, `npm run build`, and the Docker image's build — so all three agree.
#
# Your own API keys go in .env.local beside it (git-ignored; see .env.example).
# Anything named VITE_* is compiled into the JavaScript every visitor
# downloads, so nothing secret ever belongs in either file.

# Same origin: requests go to /api on whatever host served the page, and
# something in front forwards them — Vite's dev server locally, Caddy in the
# container. Keep it /. The session is an HTTP-only cookie, and the API's
# `Access-Control-Allow-Origin: *` cannot be combined with credentials, so an
# absolute address on another origin fails every call under /api/auth,
# /api/user and /api/cards with the cookie never sent.
VITE_API_BASE_URL=/

# Dev server only: where it forwards /api. Matches the backend's default port.
VITE_DEV_API_PROXY=http://localhost:3000
