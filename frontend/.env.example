# Copy to .env.local to override the defaults in .env.development.
#
# Origin of the journey-planning backend. No trailing slash; the API layer
# appends paths such as /api/route itself.
#
# The app fails fast at startup if this is unset, so a production build must be
# given a value (via .env.production, or the deploy environment) before it will
# run — it will not silently fall back to localhost.
VITE_API_BASE_URL=http://localhost:3000

# Optional. A Digitransit subscription key turns on Helsinki's transit-aware
# geocoder, whose suggestions include the network's own stops rather than only
# addresses. Free to register at https://portal-api.digitransit.fi.
#
# Leave it unset and place search falls back to Photon, which needs no key and
# covers every network — you lose stop suggestions, not search.
#
# This value ships in the browser bundle and is not a secret; Digitransit
# issues it for client-side use and rate-limits per key.
# VITE_DIGITRANSIT_SUBSCRIPTION_KEY=

# Optional. CARTO's basemap tiles (map/tileSource.ts) used to need no key at
# all; their anonymous tier has since grown unreliable, and some tiles come
# back as an "API KEY REQUIRED" watermark instead of a map without one. Free
# to register at https://carto.com — sign up, create an account, and a
# personal API key is issued from the dashboard.
#
# Leave it unset and the map still renders, just less reliably.
# VITE_CARTO_API_KEY=
