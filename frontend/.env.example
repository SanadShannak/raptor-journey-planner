# Copy to .env.local to override the defaults in .env.development.
#
# Origin of the journey-planning backend. No trailing slash; the API layer
# appends paths such as /api/route itself.
#
# The app fails fast at startup if this is unset, so a production build must be
# given a value (via .env.production, or the deploy environment) before it will
# run — it will not silently fall back to localhost.
VITE_API_BASE_URL=http://localhost:3000
